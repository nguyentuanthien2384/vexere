# Node.js 24 LTS. Development works immediately with local SQLite.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
SEED_DEMO=true
DATA_DIR=./data

# Production: NODE_ENV=production, SEED_DEMO=false, HTTPS APP_URL,
# strong SESSION_SECRET, your PostgreSQL URL and your own admin credentials.
# DATABASE_URL=postgresql://ticket4t:your-password@localhost:5432/ticket4t
PG_SSL=false
PG_SSL_REJECT_UNAUTHORIZED=true
POSTGRES_DB=ticket4t
POSTGRES_USER=ticket4t
POSTGRES_PASSWORD=replace-with-your-own-postgres-password
TRUST_PROXY=0
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email verification, reset and ticket notifications. Empty = local development outbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Ticket4T <no-reply@your-domain.vn>

# Obtain a merchant agreement and credentials before real online payments.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Public callback: APP_URL/api/payments/vnpay/ipn
# Return URL: APP_URL/api/payments/vnpay/return
