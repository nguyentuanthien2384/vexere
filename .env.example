# Node.js 24 LTS. Development works immediately with local SQLite.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
SEED_DEMO=true
DATA_DIR=./data

# Production: NODE_ENV=production, SEED_DEMO=false, HTTPS APP_URL,
# strong SESSION_SECRET, your PostgreSQL URL and your own admin credentials.
# DATABASE_URL=postgresql://ticket4t:your-password@localhost:5432/ticket4t
PG_SSL=false
PG_SSL_REJECT_UNAUTHORIZED=true
POSTGRES_DB=ticket4t
POSTGRES_USER=ticket4t
POSTGRES_PASSWORD=replace-with-your-own-postgres-password
TRUST_PROXY=0
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email verification, reset and ticket notifications. Empty = local development outbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Ticket4T <no-reply@your-domain.vn>

# Obtain a merchant agreement and credentials before real online payments.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Public callback: APP_URL/api/payments/vnpay/ipn
# Return URL: APP_URL/api/payments/vnpay/return

# Operator schedule feed, normalized JSON v1; see docs/api.md.
# Create a managed operator first, then set its ID. Use allocated seat inventory.
OPERATOR_FEED_URL=
OPERATOR_FEED_TOKEN=
OPERATOR_FEED_OPERATOR_ID=
OPERATOR_FEED_TIMEOUT_MS=8000

# MoMo captureWallet merchant credentials. Empty = method unavailable.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_URL=https://test-payment.momo.vn/v2/gateway/api/create
# Public callback: APP_URL/api/payments/momo/ipn

# ZaloPay gateway merchant credentials. Empty = method unavailable.
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_URL=https://sb-openapi.zalopay.vn/v2/create
# Public callback: APP_URL/api/payments/zalopay/ipn
