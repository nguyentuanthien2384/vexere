{
  "name": "ticket4t",
  "version": "3.0.0",
  "description": "Ticket4T — nền tảng quản lý chuyến xe và đặt vé trực tuyến",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "seed": "node scripts/seed.js",
    "check": "node scripts/check.js",
    "test": "node scripts/run-tests.js all",
    "test:unit": "node scripts/run-tests.js unit",
    "test:integration": "node scripts/run-tests.js integration",
    "test:coverage": "node scripts/run-tests.js coverage",
    "test:ci": "npm run check && npm run test:cases && npm run test:coverage",
    "test:cases": "node scripts/check-test-cases.js",
    "test:postgres": "node scripts/run-tests.js postgres",
    "test:ui:all": "node scripts/run-ui-tests.js",
    "test:ui": "node scripts/browser-smoke.js",
    "test:ui:advanced": "node scripts/browser-advanced-smoke.js",
    "test:ui:regression": "node scripts/browser-regression-smoke.js",
    "test:ui:admin": "node scripts/browser-admin-smoke.js",
    "test:ui:api": "node scripts/browser-api-smoke.js",
    "test:ui:integrations": "node scripts/browser-integrations-smoke.js",
    "db:migrate:legacy": "sequelize-cli db:migrate --config config/config.js",
    "pack:project": "node scripts/package-project.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyentuanthien2384/vexere.git"
  },
  "author": "nhom5",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/nguyentuanthien2384/vexere/issues"
  },
  "homepage": "https://github.com/nguyentuanthien2384/vexere#readme",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "nodemailer": "^10.0.15",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "fflate": "^0.8.3",
    "pg-hstore": "^2.3.4",
    "playwright": "^1.63.0",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5"
  },
  "overrides": {
    "sequelize": {
      "uuid": "^11.1.1"
    }
  }
}
